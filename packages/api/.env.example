# Supabase Configuration
# Get these values from: https://app.supabase.com → Your Project → Settings → API

# Project URL (format: https://xxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (safe to expose in client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key (NEVER expose in client, backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the values with your actual Supabase credentials
# 3. Never commit .env.local to git (it's in .gitignore)
#
# For production deployment on Vercel:
# - Set these variables in Vercel Dashboard → Settings → Environment Variables
# - Or use: vercel env add VARIABLE_NAME
